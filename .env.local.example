# Idolelic 環境変数
# このファイルをコピーして .env.local を作成してください:
#   cp .env.local.example .env.local
#
# 公開手順の全体像は docs/mvp-launch-checklist.md を参照。

# --- Supabase ---
# 1. https://supabase.com でプロジェクト作成
# 2. SQL Editor で supabase/migrations/ をファイル名順に実行
#    （20250601000000 … 20250620000000）
# 3. Project Settings > API から以下をコピー
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth: Authentication > Providers > Email を有効化
# 開発中は Email confirmations を OFF にすると即ログインできます

# Site URL (Supabase Dashboard > Authentication > URL Configuration)
# ローカル:
#   - Site URL: http://localhost:3000
#   - Redirect URLs: http://localhost:3000/auth/callback
# 本番 (Vercel):
#   - Site URL: https://<your-app>.vercel.app
#   - Redirect URLs: https://<your-app>.vercel.app/auth/callback

# --- オーナー（あなた専用・全データ管理）---
# アプリでサインアップしたメールと同じ値を設定（大文字小文字は無視）
# 設定後、マイページに「データ管理」→ /admin が表示されます
OWNER_EMAIL=you@example.com

# --- ジオコーディング（聖地登録時の住所→座標）---
# GOOGLE_MAPS_API_KEY=AIza...

# --- 開発オプション ---
NEXT_PUBLIC_DEMO_MODE=false
